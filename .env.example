# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CareerPlug ───────────────────────────────────────────────────────────────
CAREERPLUG_EMAIL=you@example.com
CAREERPLUG_PASSWORD=your-careerplug-password
CAREERPLUG_COMPANY_SLUG=your-company-slug        # appears in CareerPlug URLs

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15550000000                   # Twilio number (E.164)
TWILIO_TO_NUMBER=+15551111111                     # recipient number (E.164)

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                  # use service role, not anon key

# ── Microsoft Graph / Email trigger ──────────────────────────────────────────
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_USER_EMAIL=you@yourdomain.com
EMAIL_TRIGGER_SUBJECT=New Application             # subject substring to watch for

# ── Calendly ──────────────────────────────────────────────────────────────────
CALENDLY_LINK=https://calendly.com/your-link
CALENDLY_WEBHOOK_SIGNING_KEY=                    # from Calendly Developer → Webhooks → Signing Key

# ── Scoring thresholds ────────────────────────────────────────────────────────
SCORE_NOTIFY_THRESHOLD=2                          # SMS fires when score >= this (1–4 stars)
