# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CareerPlug ───────────────────────────────────────────────────────────────
CAREERPLUG_EMAIL=you@example.com
CAREERPLUG_PASSWORD=your-careerplug-password
CAREERPLUG_COMPANY_SLUG=your-company-slug        # appears in CareerPlug URLs

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15550000000                   # Twilio number (E.164)
TWILIO_TO_NUMBER=+15551111111                     # recipient number (E.164)

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                  # use service role, not anon key

# ── Email / IMAP trigger ──────────────────────────────────────────────────────
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=your-app-password                  # Gmail: use an App Password
EMAIL_FOLDER=INBOX
EMAIL_TRIGGER_SUBJECT=New Application             # subject substring to watch for

# ── Scoring thresholds ────────────────────────────────────────────────────────
SCORE_NOTIFY_THRESHOLD=7                          # SMS fires when score >= this (1-10)
